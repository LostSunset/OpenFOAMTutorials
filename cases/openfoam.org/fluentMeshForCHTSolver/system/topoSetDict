FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    //- Create solid zone
    {
        name solid;
        type cellZoneSet;
        action new;
        source setToCellZone;
        sourceInfo
        {
            set solid; 
        }
    }
    //- Create fluid zone
    {
        name fluid;
        type cellZoneSet;
        action new;
        source setToCellZone;
        sourceInfo
        {
            set fluid; 
        }
    }
);

