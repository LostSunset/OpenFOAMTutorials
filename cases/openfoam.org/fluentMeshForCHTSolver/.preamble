#------------------------------------------------------------------------------
# Preamble with the information about the tutorial
echo -en "
-------------------------------------------------------------------------------
${GRAY}Tutorial by Tobias Holzmann${NC} :: Generated on October 2016  
${GRAY}Build for OpenFOAM version${NC}  :: OpenFOAM-8
${GRAY}Tested on system${NC}            :: Ubuntu 20.04.1
${GRAY}The case was updated on${NC}     :: 06 September 2020
-------------------------------------------------------------------------------


${GREEN}Topic: Convert a region fluent mesh to a region foam mesh for CHT${NC}
-------------------------------------------------------------------------------

Thanks to ${GREEN}Ahmed Elsayed${NC} for the idea of this kind of tutorial. 


-------------------------------------------------------------------------------
"


#------------------------------------------------------------------------------
# Check the OpenFOAM version
echo -e "  - Check OpenFOAM version. We need $foamVersion"
userFoamVersion=`echo "$WM_PROJECT-$WM_PROJECT_VERSION"` 

if [ "$userFoamVersion" == "$foamVersion" ]
then
    echo -e  "  - ${GREEN}$foamVersion found...${NC}"

else
    echo -e  "  - ${ORANGE}You are not using the correct OpenFOAM version"
    echo -en "    Your version is $userFoamVersion and we need ${GREEN}"
    echo -e  "$foamVersion${NC}\n"

    while true
    do
        echo -en  "  - Proceed with your OpenFOAM version (y/n): "
        read proceed

        if [ "$proceed" == "y" ]
        then
            break

        elif [ "$proceed" == "n" ]
        then
            echo -e "\n\n"
            exit

        fi
    done
fi


#------------------------------------------------------------------------------
