FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    T
    {
        solver          GAMG;
        tolerance       1e-12;
        relTol          0.01;
        smoother        DIC;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 10;
        agglomerator    faceAreaPair;
        mergeLevels     1;
        /*solver          PBiCG;
        preconditioner  DILU;*/
         
        tolerance       1e-10;
        relTol          0.01;
    }

    TFinal
    {
        $T;
        tolerance       1e-10;
        relTol          0;
    }
}

PIMPLE
{
    nOuterCorrectors    10;
    nCorrectors         3;
}

relaxationFactors
{
    fields
    {
    }
    equations
    {
        T           0.4;
        TFinal      1;
    }
}

cache
{
    grad(U);
}

