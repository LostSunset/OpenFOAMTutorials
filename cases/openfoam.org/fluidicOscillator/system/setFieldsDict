FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    //- Set alpha everywhere to zero
    volScalarFieldValue alpha.water 0
);

regions
(
    //- Set alpha to 1 in the box
    boxToCell
    {
        box (0 -1 -1) (0.070 1 1);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
);


