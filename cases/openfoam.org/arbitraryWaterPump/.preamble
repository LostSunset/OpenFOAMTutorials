#------------------------------------------------------------------------------
# Preamble with the information about the tutorial
echo -en "
-------------------------------------------------------------------------------
${GRAY}Tutorial by Tobias Holzmann${NC} :: Generated on February 2017
${GRAY}Build for OpenFOAM version${NC}  :: OpenFOAM-8
${GRAY}Tested on system${NC}            :: Ubuntu 20.04.1
${GRAY}The case was updated on${NC}     :: 14 Januar 2021
-------------------------------------------------------------------------------


${GREEN}Topic: Create a simple mesh with correct cyclic BC${NC}
-------------------------------------------------------------------------------
Since OpenFOAM v8, Tobias is using the »fixedJump« boundary condition to solve
the problem which was analyzed using the »fan« boundary condition in prior
versions. This boundary condition does not exist anymore. One can also use the
»fanPressure« boundary condition to get a more sophisticated approach
"


#------------------------------------------------------------------------------
# Check the OpenFOAM version
echo -e "  - Check OpenFOAM version. We need $foamVersion"
userFoamVersion=`echo "$WM_PROJECT-$WM_PROJECT_VERSION"`

if [ "$userFoamVersion" == "$foamVersion" ]
then
    echo -e  "  - ${GREEN}$foamVersion found...${NC}"

else
    echo -e  "  - ${ORANGE}You are not using the correct OpenFOAM version"
    echo -en "    Your version is $userFoamVersion and we need ${GREEN}"
    echo -e  "$foamVersion${NC}\n"

    while true
    do
        echo -en  "  - Proceed with your OpenFOAM version (y/n): "
        read proceed

        if [ "$proceed" == "y" ]
        then
            break

        elif [ "$proceed" == "n" ]
        then
            echo -e "\n\n"
            exit

        fi
    done
fi


#------------------------------------------------------------------------------
