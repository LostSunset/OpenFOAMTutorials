FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet 
    {
        type            surfaceNormalFixedValue;
        refValue        uniform -0.2;
        value           uniform (0 0 0);
    }

    outlet 
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }

    innerWall 
    {
        type            noSlip;
    }

    outerWall 
    {
        type            noSlip;
    }

    pipe    
    {
        type            movingWallVelocity;
        value           uniform (0 0 0);
    }

    AMI1
    {
        //type            movingWallSlipVelocity;
        //value           uniform (0 0 0);
        type            zeroGradient
    }

    AMI2
    {
        //type            movingWallSlipVelocity;
        //value           uniform (0 0 0);
        type            zeroGradient;
    }

    front
    {
        type            empty;
    }

    back 
    {
        type            empty;
    }
}

