FoamFile
{
    version     2.0;
    format      binary;
    class       volScalarField;
    location    "0";
    object      S;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            fixedValue;
        value           uniform 1;
    }

    outlet 
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }

    pipe
    {
        type            zeroGradient;
    }

    innerWall 
    {
        type            zeroGradient;
    }

    outerWall 
    {
        type            zeroGradient;
    }

    AMI1
    {
        type            zeroGradient;
    }

    AMI2
    {
        type            zeroGradient;
    }

    front
    {
        type            empty;
    }

    back 
    {
        type            empty;
    }
}


