triSurfaceChannel
{
    surfaces
    (
        "channel.stl"
    );

    // Mark edges whose adjacent surface normals are at an angle less
    // than includedAngle as features
    // - 0  : selects no edges
    // - 180: selects all edges
    includedAngle   120;

    geometricalTestOnly    extractFromSurface;

    writeObj                no;
    writeVTK                no;
}


