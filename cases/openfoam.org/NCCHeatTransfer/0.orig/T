FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 273;

boundaryField
{
    #includeEtc         "caseDicts/setConstraintTypes"

    adiabaticWalls 
    {
        type            zeroGradient;
    }

    constWall 
    {
        type            fixedValue;
        value           uniform 273;
    }

    hotWall 
    {
        type            fixedValue;
        value           uniform 500;
    }

    front
    {
        type            empty;
    }

    back
    {
        type            empty;
    }

    interfaceStatic
    {
        type            zeroGradient;
    }

    interfaceMoving 
    {
        type            zeroGradient;
    }
}

