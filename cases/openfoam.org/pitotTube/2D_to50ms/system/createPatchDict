FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync false;

patches
(
    {
        name front;

        patchInfo
        {
            type empty;
        }

        constructFrom patches;

        patches (front1);
    }
    {
        name back;

        patchInfo
        {
            type empty;
        }

        constructFrom patches;

        patches (back1);
    }
    {
        name walls;

        patchInfo
        {
            type wall;
        }

        constructFrom patches;

        patches (walls1);
    }
);

