FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync false;

patches
(
    {
        name frontEmpty;

        patchInfo
        {
            type empty;
        }

        constructFrom patches;

        patches (frontEmpty);
    }
    {
        name backEmpty;

        patchInfo
        {
            type empty;
        }

        constructFrom patches;

        patches (backEmpty);
    }
    {
        name walls;

        patchInfo
        {
            type wall;
        }

        constructFrom patches;

        patches (walls);
    }
);

