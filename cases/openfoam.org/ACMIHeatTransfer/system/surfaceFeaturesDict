FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      surfaceFeaturesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


interface
{
    surfaces
    (
        "interface.stl"
    );

    // Mark edges whose adjacent surface normals are at an angle less
    // than includedAngle as features
    // - 0  : selects no edges
    // - 180: selects all edges
    includedAngle   150;

    geometricalTestOnly    extractFromSurface;

    writeObj                no;
    writeVTK                no;
}


regionSTL
{
    surfaces
    (
        "regionSTL.stl"
    );

    // Mark edges whose adjacent surface normals are at an angle less
    // than includedAngle as features
    // - 0  : selects no edges
    // - 180: selects all edges
    includedAngle   150;

    geometricalTestOnly    extractFromSurface;

    writeObj                no;
    writeVTK                no;
}


