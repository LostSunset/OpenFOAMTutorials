FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    h
    {
        solver           PCG;
        preconditioner   DIC;
        tolerance        1e-08;
        relTol           0.1;
        minIter          1;
    }

    hFinal
    {
        $h;
        tolerance        1e-08;
        relTol           0;
    }
}

PIMPLE
{
    nNonOrthogonalCorrectors 0;

    residualControl
    {
        h
        {
            relTol  0;
            tolerance 1e-5;
        }
    }
}

relaxationFactors
{
    equations
    {
        h     0.8;
    }
}

