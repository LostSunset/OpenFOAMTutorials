FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    back
    {
        type            empty;
    }
    front
    {
        type            empty;
    }
    outlet 
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }
    inletHot 
    {
        type            fixedValue;
        value           uniform (0.03 0 0);
    }
    inletCold 
    {
        type            fixedValue;
        value           uniform (0 0.08 0);
    }
    wall
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
}


