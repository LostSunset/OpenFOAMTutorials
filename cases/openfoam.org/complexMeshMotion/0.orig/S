FoamFile
{
    version     2.0;
    format      binary;
    class       volScalarField;
    location    "0";
    object      S;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    back
    {
        type            empty;
    }
    front
    {
        type            empty;
    }
    outlet 
    {
        type            zeroGradient;
    }
    inlet 
    {
        type            fixedValue;
        value           uniform 0;
    }

    walls
    {
        type            zeroGradient;
    }

    ACMI1_blockage
    {
        type            zeroGradient;
        value           uniform 0;
    }

    ACMI2_blockage
    {
        type            zeroGradient;
        value           uniform 0;
    }

    ACMI1_couple
    {
        type            cyclicACMI;
        value           uniform 0;
    }

    ACMI2_couple
    {
        type            cyclicACMI;
        value           uniform 0;
    }
}


