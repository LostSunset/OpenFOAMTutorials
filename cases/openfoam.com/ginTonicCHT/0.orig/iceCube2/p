FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/iceCube2";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 1 -1 -2 0 0 0 0 ];

internalField   uniform 100000;

boundaryField
{
    isolated
    {
        type            calculated;
        value           $internalField;
    }
    iceCube2_to_ginTonic
    {
        type            calculated;
        value           $internalField;
    }
}


