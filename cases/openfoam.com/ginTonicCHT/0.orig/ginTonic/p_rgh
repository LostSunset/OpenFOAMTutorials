FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/ginTonic";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 1 -1 -2 0 0 0 0 ];

internalField   uniform 100000;

boundaryField
{
    top
    {
        type            totalPressure;
        p0              $internalField;
        value           $internalField;
    }
    fixedWalls
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    ginTonic_to_iceCube1
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    ginTonic_to_iceCube2
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
}


