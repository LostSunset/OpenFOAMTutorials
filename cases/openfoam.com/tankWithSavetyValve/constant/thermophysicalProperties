FoamFile
{
    version         2012;
    format          ascii;
    class           dictionary;
    location        "constant";
    object          thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight       28.9644;
        nMoles          1;
    }

    thermodynamics
    {
        Cp              1000;
        Hf              0;
    }

    transport
    {
        mu              1.8e-05;
        Pr              0.71;
    }

}


